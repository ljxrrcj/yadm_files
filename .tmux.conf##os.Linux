set-option -g mouse on
set -g prefix C-space

if-shell '[ $(uname -s) = Linux ]' \
    'set -g default-terminal "xterm-256color"'
set -g escape-time 20

set -ga update-environment TERM
set -ga update-environment TERM_PROGRAM

bind-key h select-pane -L
bind-key j select-pane -D
bind-key k select-pane -U
bind-key l select-pane -R
bind-key -T copy-mode-vi v send-keys -X begin-selection

set-clipboard external
set-clipboard on

# List of plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'ljxrrcj/tmux-open'

# ---- tmux-resurrect + tmux-continuum：断电/重启后恢复会话 ----
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
# pane 屏幕内容不保存/不恢复（capture-pane-contents 默认 off）
# 每次保存后记录 pane→claude session id 映射，供断电后精确恢复
set -g @resurrect-hook-post-save-all '~/.local/bin/tmux-claude-map.sh'
set -g @continuum-restore 'on'
set -g @continuum-save-interval '10'

# Initialize TMUX plugin manager (keep this line at the very bottom of tmux.conf)
run '~/.tmux/plugins/tpm/tpm'
